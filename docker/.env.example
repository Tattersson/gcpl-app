# PostgreSQL Configuration
POSTGRES_USER=gcpl
POSTGRES_PASSWORD=gcpl_secret
POSTGRES_DB=gcpl_db
POSTGRES_PORT=5432

# Application Configuration
APP_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Required. Generate with: openssl rand -base64 48  (the app refuses to run in production without a non-default value)
AUTH_SECRET=

# Optional Keycloak Testing Container (--profile keycloak)
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
